# Relative to server/prisma/schema.prisma
DATABASE_URL="file:./dev.db"
# Must match the portal configuration; replace locally, never commit real secrets.
SSO_JWT_SECRET="replace-with-your-portal-shared-secret"
PORT=3000
# Optional: BACKUP_DIR and AUTOMATION_BROWSER_CHANNEL

# Deployment options (do not overwrite an existing .env)
# NODE_ENV=production
# ALLOWED_ORIGINS=https://cept.example.com
# TRUST_PROXY=1
# SESSION_COOKIE_SECURE=true
# Session cookies are secure by default in production; use HTTPS.
